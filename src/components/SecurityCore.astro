---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/guru-charan-hero.webp';
---
<div class="security-core" data-security-core>
  <canvas class="security-core-canvas" data-security-core-canvas aria-hidden="true"></canvas>

  <div class="security-core-center" aria-hidden="true">
    <span class="core-ring core-ring-one"></span>
    <span class="core-ring core-ring-two"></span>
    <span class="core-ring core-ring-three"></span>
    <span class="core-pulse"></span>
    <span class="core-label">GC</span>
  </div>

  <div class="identity-node" data-tilt>
    <div class="identity-photo">
      <Image
        src={heroImage}
        alt="Guru Charan Mavuduru wearing a navy blazer"
        widths={[240, 360, 480]}
        sizes="180px"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="identity-copy">
      <span>Operator profile</span>
      <strong>Guru Charan</strong>
      <small>AI security · SOC engineering</small>
    </div>
  </div>

  <div class="signal-tag signal-tag-ai" data-signal="ai"><span></span>AI reasoning</div>
  <div class="signal-tag signal-tag-soc" data-signal="soc"><span></span>SOC telemetry</div>
  <div class="signal-tag signal-tag-build" data-signal="build"><span></span>Systems in progress</div>

  <div class="core-caption">
    <span class="core-caption-status"><i></i> Live portfolio system</span>
    <strong>Security Intelligence Core</strong>
    <small>Move your pointer or scroll to explore the system.</small>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-security-core]');
    const canvas = root?.querySelector('[data-security-core-canvas]');
    if (!root || !(canvas instanceof HTMLCanvasElement)) return;

    const context = canvas.getContext('2d');
    if (!context) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pointer = { x: 0, y: 0, targetX: 0, targetY: 0 };
    let width = 0;
    let height = 0;
    let dpr = 1;
    let frame = 0;
    let active = true;

    const nodes = Array.from({ length: 34 }, (_, index) => ({
      angle: (Math.PI * 2 * index) / 34,
      radius: 0.2 + ((index * 37) % 75) / 100,
      speed: 0.00035 + ((index * 11) % 9) * 0.000045,
      size: 1.3 + ((index * 13) % 28) / 10,
      layer: index % 3,
      pulse: ((index * 17) % 100) / 100,
    }));

    const palette = () => {
      const styles = getComputedStyle(document.documentElement);
      return {
        line: styles.getPropertyValue('--v4-line').trim() || 'rgba(120, 200, 255, .28)',
        cyan: styles.getPropertyValue('--v4-cyan').trim() || '#67e8f9',
        amber: styles.getPropertyValue('--v4-amber').trim() || '#ff9d5c',
        violet: styles.getPropertyValue('--v4-violet').trim() || '#a78bfa',
      };
    };

    const resize = () => {
      const rect = root.getBoundingClientRect();
      width = Math.max(320, rect.width);
      height = Math.max(440, rect.height);
      dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const pointFor = (node, time) => {
      const base = Math.min(width, height) * 0.36;
      const radius = base * (0.32 + node.radius * 0.82);
      const angle = node.angle + time * node.speed * (node.layer % 2 ? 1 : -1);
      const squash = 0.63 + node.layer * 0.08;
      return {
        x: width * 0.51 + Math.cos(angle) * radius + pointer.x * (8 + node.layer * 3),
        y: height * 0.43 + Math.sin(angle) * radius * squash + pointer.y * (6 + node.layer * 2),
      };
    };

    const draw = (time = 0) => {
      if (!active) return;
      const colors = palette();
      context.clearRect(0, 0, width, height);

      pointer.x += (pointer.targetX - pointer.x) * 0.035;
      pointer.y += (pointer.targetY - pointer.y) * 0.035;

      const centerX = width * 0.51 + pointer.x * 8;
      const centerY = height * 0.43 + pointer.y * 7;
      const maxRadius = Math.min(width, height) * 0.31;

      context.save();
      context.translate(centerX, centerY);
      context.rotate(time * 0.000055);
      [1, .72, .46].forEach((scale, index) => {
        context.beginPath();
        context.ellipse(0, 0, maxRadius * scale, maxRadius * scale * (.54 + index * .04), index * .58, 0, Math.PI * 2);
        context.strokeStyle = colors.line;
        context.lineWidth = index === 0 ? 1.2 : .8;
        context.setLineDash(index === 1 ? [5, 9] : index === 2 ? [2, 12] : []);
        context.stroke();
      });
      context.restore();
      context.setLineDash([]);

      const points = nodes.map((node) => pointFor(node, time));
      for (let i = 0; i < points.length; i++) {
        for (let j = i + 1; j < points.length; j++) {
          const dx = points[i].x - points[j].x;
          const dy = points[i].y - points[j].y;
          const distance = Math.hypot(dx, dy);
          if (distance > 88) continue;
          context.beginPath();
          context.moveTo(points[i].x, points[i].y);
          context.lineTo(points[j].x, points[j].y);
          context.strokeStyle = colors.line;
          context.globalAlpha = (1 - distance / 88) * .6;
          context.lineWidth = .65;
          context.stroke();
        }
      }
      context.globalAlpha = 1;

      points.forEach((point, index) => {
        const node = nodes[index];
        const color = node.layer === 0 ? colors.cyan : node.layer === 1 ? colors.amber : colors.violet;
        const pulse = reduced ? 1 : .7 + Math.sin(time * .002 + node.pulse * 8) * .3;
        context.beginPath();
        context.arc(point.x, point.y, Math.max(1, node.size * pulse), 0, Math.PI * 2);
        context.fillStyle = color;
        context.globalAlpha = .35 + node.layer * .22;
        context.fill();
        context.globalAlpha = 1;
      });

      if (!reduced) frame = requestAnimationFrame(draw);
    };

    root.addEventListener('pointermove', (event) => {
      const rect = root.getBoundingClientRect();
      pointer.targetX = ((event.clientX - rect.left) / rect.width - .5) * 2;
      pointer.targetY = ((event.clientY - rect.top) / rect.height - .5) * 2;
    });

    root.addEventListener('pointerleave', () => {
      pointer.targetX = 0;
      pointer.targetY = 0;
    });

    const observer = new IntersectionObserver((entries) => {
      active = entries[0]?.isIntersecting ?? true;
      if (active && !reduced && !frame) frame = requestAnimationFrame(draw);
      if (!active && frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }
    }, { threshold: .05 });

    observer.observe(root);
    new ResizeObserver(resize).observe(root);
    resize();
    draw(0);

    new MutationObserver(() => draw(performance.now())).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  })();
</script>
