---
const worlds = [
  { id:'command', label:'COMMAND DECK', subtitle:'The living entry point', href:'/', color:'cyan', x:50, y:50, z:0 },
  { id:'cybergpt', label:'CYBERGPT', subtitle:'AI incident-response world', href:'/projects/cybergpt/', color:'violet', x:22, y:34, z:-80 },
  { id:'ra-xsoc', label:'RA-XSOC', subtitle:'Adaptive SOC intelligence', href:'/projects/cybergpt/', color:'blue', x:76, y:30, z:-140 },
  { id:'osprey', label:'OSPREY MPPT', subtitle:'Solar optimization world', href:'/projects/osprey-mppt/', color:'amber', x:28, y:74, z:-170 },
  { id:'sahaaya', label:'SAHAAYA360', subtitle:'Institutional operations world', href:'/projects/sahaaya360/', color:'green', x:74, y:72, z:-220 },
  { id:'museum', label:'PORTFOLIO MUSEUM', subtitle:'The archive of experiments', href:'/projects/portfolio-v2/', color:'rose', x:50, y:84, z:-300 },
];
---
<section class="galaxy-engine" data-galaxy-engine aria-label="GURUVERSE galaxy">
  <div class="galaxy-sky" aria-hidden="true"><div class="galaxy-nebula galaxy-nebula-a"></div><div class="galaxy-nebula galaxy-nebula-b"></div><div class="galaxy-starfield" data-galaxy-stars></div><div class="galaxy-grid"></div></div>
  <div class="galaxy-camera" data-galaxy-camera><div class="galaxy-worlds" data-galaxy-worlds>
    {worlds.map((world) => <a class="galaxy-world" data-galaxy-world={world.id} data-world-x={world.x} data-world-y={world.y} data-world-z={world.z} data-color={world.color} href={world.href} style={'--world-x:'+world.x+'%;--world-y:'+world.y+'%;--world-z:'+world.z+'px'}>
      <span class="galaxy-world-orbit" aria-hidden="true"></span><span class="galaxy-world-core" aria-hidden="true"></span><span class="galaxy-world-label"><b>{world.label}</b><small>{world.subtitle}</small></span>
    </a>)}
  </div></div>
  <div class="galaxy-hud"><div><span class="galaxy-hud-kicker">GURUVERSE // GALAXY ENGINE</span><strong data-galaxy-location>COMMAND DECK</strong></div><div class="galaxy-hud-actions"><button type="button" data-galaxy-focus>FOCUS</button><button type="button" data-galaxy-explore>EXPLORE</button></div></div>
  <div class="galaxy-guide" data-galaxy-guide hidden><span>GURU-BOT NAVIGATION</span><strong data-galaxy-guide-title>Choose a world.</strong><p data-galaxy-guide-copy>Move through the galaxy to inspect a project world, origin, career, or archive.</p></div>
</section>
<script define:vars={{ worlds }}>
  (() => {
    const root = document.querySelector('[data-galaxy-engine]'); if (!(root instanceof HTMLElement)) return;
    const worldsLayer = root.querySelector('[data-galaxy-worlds]'); const locationLabel = root.querySelector('[data-galaxy-location]');
    const guide = root.querySelector('[data-galaxy-guide]'); const guideTitle = root.querySelector('[data-galaxy-guide-title]'); const guideCopy = root.querySelector('[data-galaxy-guide-copy]');
    const focus = root.querySelector('[data-galaxy-focus]'); const explore = root.querySelector('[data-galaxy-explore]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stateNames = ['IDLE','OBSERVE','WALK','RUN','FLY','GUIDE','TALK','CELEBRATE','SLEEP','WAKE','RETURN_HOME'];
    let stateIndex = 0, active = 'command', rx = 0, ry = 0, cameraZ = 0;
    const setGuruState = (state) => { document.body.dataset.guruState = state; root.dataset.guruState = state; window.dispatchEvent(new CustomEvent('guru:state', { detail: state })); };
    const setActive = (id, announce = true) => {
      const target = worlds.find((world) => world.id === id) || worlds[0]; active = target.id;
      root.querySelectorAll('[data-galaxy-world]').forEach((node) => { if (node instanceof HTMLElement) node.classList.toggle('is-active', node.dataset.galaxyWorld === active); });
      if (locationLabel) locationLabel.textContent = target.label; if (guideTitle) guideTitle.textContent = target.label; if (guideCopy) guideCopy.textContent = target.subtitle; if (guide instanceof HTMLElement) guide.hidden = false;
      if (announce) setGuruState('GUIDE');
      cameraZ = Math.min(280, Math.max(0, Math.abs(target.z)));
      if (worldsLayer instanceof HTMLElement && !reduced) worldsLayer.style.transform = 'translate3d('+(50-target.x)+'%,'+(50-target.y)+'%,'+cameraZ+'px) rotateX('+rx+'deg) rotateY('+ry+'deg)';
    };
    root.querySelectorAll('[data-galaxy-world]').forEach((node) => {
      node.addEventListener('mouseenter', () => { const id = node instanceof HTMLElement ? node.dataset.galaxyWorld : ''; if (id) setActive(id, false); });
      node.addEventListener('focus', () => { const id = node instanceof HTMLElement ? node.dataset.galaxyWorld : ''; if (id) setActive(id, false); });
      node.addEventListener('click', () => { setGuruState('FLY'); window.dispatchEvent(new CustomEvent('guru:talk', { detail: { world: node instanceof HTMLElement ? node.dataset.galaxyWorld : '' } })); });
    });
    focus?.addEventListener('click', () => { setActive(active); setGuruState('GUIDE'); });
    explore?.addEventListener('click', () => { const current = worlds.findIndex((world) => world.id === active); setActive(worlds[(current+1)%worlds.length].id); setGuruState('RUN'); });
    if (!reduced && window.matchMedia('(pointer:fine)').matches) root.addEventListener('pointermove', (event) => {
      const rect = root.getBoundingClientRect(); const x=(event.clientX-rect.left)/rect.width-.5; const y=(event.clientY-rect.top)/rect.height-.5; rx=y*-5; ry=x*7;
      if (worldsLayer instanceof HTMLElement) worldsLayer.style.transform = 'translate3d('+(x*-3)+'%,'+(y*-3)+'%,'+cameraZ+'px) rotateX('+rx+'deg) rotateY('+ry+'deg)';
    }, { passive:true });
    if (!reduced) window.setInterval(() => { stateIndex=(stateIndex+1)%stateNames.length; setGuruState(stateNames[stateIndex]); }, 6200);
    window.addEventListener('guru:home', () => { setActive('command'); setGuruState('RETURN_HOME'); });
    setActive('command', false);
  })();
</script>
