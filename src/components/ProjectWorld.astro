---
interface Props { title:string; domain:string; description:string; technologies:string[]; }
const { title, domain, description, technologies } = Astro.props;
const steps = ['INPUT','INTELLIGENCE','DECISION','EVIDENCE','OUTCOME'];
---
<section class="project-world" data-project-world data-guru-context={`PROJECT WORLD — ${title} interactive architecture.`} aria-label={`${title} project world`}>
  <div class="project-world-stars" aria-hidden="true"></div>
  <div class="project-world-head">
    <span class="eyebrow">PROJECT WORLD · {domain}</span>
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
  <div class="project-orbit" aria-label="Project architecture flow">
    <div class="project-core"><span>GURU-BOT</span><strong>PROJECT<br />CORE</strong></div>
    {steps.map((step,index)=><button type="button" class="project-node" style={`--node:${index}`} data-project-node data-step={step}><span>0{index+1}</span><strong>{step}</strong></button>)}
    <div class="project-beam project-beam-a"></div><div class="project-beam project-beam-b"></div>
  </div>
  <div class="project-world-panel" data-project-panel>
    <span data-project-panel-label>PROJECT SIGNAL</span>
    <strong data-project-panel-title>Choose an architecture layer</strong>
    <p data-project-panel-copy>Use the nodes to inspect how this project moves from problem to evidence.</p>
  </div>
  <div class="project-tech-strip"><span>STACK</span>{technologies.slice(0,8).map((tech)=><b>{tech}</b>)}</div>
</section>
<script>
(()=>{const root=document.querySelector('[data-project-world]');if(!root)return;const copy={INPUT:['INPUT','What enters the system?','Start with the problem, data, incident, request or physical signal the system receives.'],INTELLIGENCE:['INTELLIGENCE','How is information transformed?','This layer represents retrieval, analysis, modelling, processing or system logic.'],DECISION:['DECISION','Where does reasoning become action?','The system converts processed evidence into a decision, recommendation, control signal or workflow.'],EVIDENCE:['EVIDENCE','What can be demonstrated?','Separate implemented behavior from assumptions, experiments and planned work.'],OUTCOME:['OUTCOME','What does the system produce?','The final value is the observable result, limitation and next engineering step.']};const label=root.querySelector('[data-project-panel-label]'),title=root.querySelector('[data-project-panel-title]'),text=root.querySelector('[data-project-panel-copy]');root.querySelectorAll('[data-project-node]').forEach(node=>node.addEventListener('click',()=>{const d=copy[node.dataset.step];root.querySelectorAll('[data-project-node]').forEach(n=>n.classList.remove('active'));node.classList.add('active');label.textContent=d[0];title.textContent=d[1];text.textContent=d[2]}));})();
</script>
