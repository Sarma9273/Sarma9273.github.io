---
import '../styles/global.css';
import '../styles/responsive.css';
import Header from '../features/navigation/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { site } from '../data/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { title = site.title, description = site.description, image = '/images/og-portfolio.jpg', type = 'website', noindex = false } = Astro.props;
const world = Astro.url.pathname === '/' ? 'command' : Astro.url.pathname.startsWith('/projects') ? 'projects' : Astro.url.pathname.startsWith('/blogs') ? 'archive' : Astro.url.pathname.startsWith('/experience') ? 'career' : Astro.url.pathname.startsWith('/about') ? 'origin' : Astro.url.pathname.startsWith('/contact') ? 'contact' : 'professional';
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const fullTitle = title === site.title ? title : `${title} | ${site.shortName}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  image: imageUrl.href,
  email: `mailto:${site.email}`,
  jobTitle: 'Cybersecurity and Applied AI Professional',
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Aditya Institute of Technology and Management' }],
  memberOf: { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Technology Patna' },
  sameAs: site.socials.filter((item) => item.href.startsWith('http')).map((item) => item.href),
};
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#080b12" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="alternate" type="application/rss+xml" title="Guru Charan Mavuduru technical blog" href="/rss.xml" />
    <ClientRouter fallback="animate" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/signature-engine.ts"></script>
    <script is:inline>
      (() => {
        document.documentElement.classList.add('has-js');
        document.documentElement.dataset.theme = localStorage.getItem('theme') || 'dark';
      })();
    </script>
  </head>
  <body data-guru-page={Astro.url.pathname} data-guru-world={world}>
    <div class="gv-page-loader" aria-hidden="true" data-page-loader transition:persist>
      <div class="gv-loader-grid"></div>
      <div class="gv-loader-mark"><span>GC</span><i></i></div>
      <p>GURUVERSE <span>INITIALIZING EXPERIENCE</span></p>
    </div>
    <div class="gv-scroll-progress" aria-hidden="true" transition:persist><span data-scroll-progress></span></div>
    <canvas class="gv-atmosphere" aria-hidden="true" data-atmosphere transition:persist></canvas>
    <div class="gv-cursor" aria-hidden="true" data-cursor transition:persist><span></span></div>
    <button class="gv-sound-toggle" type="button" aria-label="Toggle interface sound" aria-pressed="false" data-sound-toggle transition:persist><span>◌</span><b>SOUND</b></button>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <BackToTop />
  </body>
</html>
