---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { experience } from '../data/profile';
---
<BaseLayout title="Experience" description="Guru Charan Mavuduru's experience across computer education, cybersecurity training, engineering design and electrical infrastructure.">
  <section class="page-hero personal-page-hero" data-guru-context="Career world — the roles that shaped the way I work.">
    <div class="container narrow reveal" data-reveal>
      <span class="eyebrow">Where I have learned by working</span>
      <h1>Teaching, training and engineering roles that changed how I approach problems.</h1>
      <p>
        Teaching taught me to explain. Cybersecurity training taught me to
        investigate. Engineering taught me discipline, documentation and
        precision. Together they shaped how I build systems today.
      </p>
    </div>
  </section>

  <section class="section" data-guru-context="Experience timeline — teaching, training, engineering and infrastructure.">
    <div class="container">
      <div class="experience-list">
        {experience.map((item,index) => (
          <article class="experience-item reveal" data-reveal>
            <div class="experience-index">{String(index+1).padStart(2,'0')}</div>
            <div class="experience-main">
              <div class="experience-header">
                <div>
                  <span class="eyebrow">{item.period}</span>
                  <h2>{item.role}</h2>
                  <strong>{item.organisation}</strong>
                </div>
                <span class="location"><Icon name="location" size={17} />{item.location}</span>
              </div>
              <ul>{item.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container narrow">
      <div class="cta-panel personal-cta reveal" data-reveal>
        <div>
          <span class="eyebrow">Direction</span>
          <h2>Building toward independent AI security engineering and technical writing.</h2>
          <p>
            I am developing toward work that combines security investigation,
            applied AI, research and clear technical explanation. The immediate
            environment I want to learn in is a real security-operations or
            security-engineering team.
          </p>
        </div>
        <a class="button button-primary" href="/resume/">Open my resume <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>