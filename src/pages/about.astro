---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import ArchitectureMap from '../features/architecture/ArchitectureMap.astro';
import aboutImage from '../assets/images/guru-charan-about.webp';
import { education, skills, certifications } from '../data/profile';
---
<BaseLayout title="My Story" description="The education, transition, interests and working principles behind Guru Charan Mavuduru's cybersecurity, AI and research journey.">
  <section class="page-hero personal-page-hero">
    <div class="container narrow reveal" data-reveal>
      <span class="eyebrow">My story</span>
      <h1>I open systems, understand them, build them, and explain them.</h1>
      <p>
        My direction grew from curiosity rather than a single planned career:
        electrical systems led me to ask what is happening inside machines;
        cybersecurity made me ask what is happening inside the internet; AI
        became a way to make security work faster and more useful.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="about-image reveal" data-reveal data-tilt>
        <Image src={aboutImage} alt="Portrait of Guru Charan Mavuduru" widths={[480,720,960]} sizes="(max-width: 850px) 90vw, 38vw" />
      </div>
      <div class="about-copy reveal" data-reveal>
        <span class="eyebrow">Why these fields connect</span>
        <h2>Curiosity became a method.</h2>
        <p>
          My EEE background gave me a systems mindset. Cybersecurity added
          adversarial reasoning, evidence and incident response. AI&DSE is
          adding retrieval, modelling, data and automation. Teaching keeps me
          focused on the final test: can another person understand the system?
        </p>
        <p>
          I use projects as proof of learning. The goal is not to present
          everything as finished; it is to make the implementation, failures,
          decisions and limitations inspectable.
        </p>
        <div class="principles">
          <div><Icon name="check" size={20} /><span>Build in small phases and keep each phase demonstrable.</span></div>
          <div><Icon name="check" size={20} /><span>Document failures and fixes, not only polished outcomes.</span></div>
          <div><Icon name="check" size={20} /><span>Use AI to support human judgement rather than hide uncertainty.</span></div>
          <div><Icon name="check" size={20} /><span>Prefer understandable systems over unnecessary complexity.</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container narrow">
      <SectionHeading eyebrow="The through-line" title="Machines → internet → cybersecurity → AI → engineering" />
      <div class="gv-story-path">
        <article><span>01</span><h3>Open</h3><p>Understand what is inside a system instead of treating it as a black box.</p></article>
        <article><span>02</span><h3>Investigate</h3><p>Follow evidence, signals and failure conditions to explain what happened.</p></article>
        <article><span>03</span><h3>Build</h3><p>Turn learning into working prototypes, products, labs and research.</p></article>
        <article><span>04</span><h3>Explain</h3><p>Teach the result so a complex system becomes easier for someone else to understand.</p></article>
      </div>
    </div>
  </section>

  <ArchitectureMap />

  <section class="section section-muted">
    <div class="container">
      <SectionHeading eyebrow="Education" title="The academic chapters behind my current direction" />
      <div class="timeline">
        {education.map((item) => (
          <article class="reveal" data-reveal>
            <div class="timeline-marker"></div>
            <span>{item.period}</span>
            <h3>{item.qualification}</h3>
            <strong>{item.institution}</strong>
            <p>{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="What I use" title="Skills organised around the work I am trying to do" />
      <div class="skills-grid">
        {skills.map((group) => (
          <article class="reveal" data-reveal>
            <h3>{group.group}</h3>
            <ul class="tag-list large">{group.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container">
      <SectionHeading eyebrow="Professional learning" title="Selected training that supported the journey" />
      <div class="certificate-grid">
        {certifications.map((item) => (
          <div class="reveal" data-reveal><Icon name="check" size={20} /><span>{item}</span></div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>