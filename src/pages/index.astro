---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../features/projects/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { education, experience } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 4);
const blogs = (await getCollection('blogs', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredBlogs = blogs.filter((post) => post.data.featured).slice(0, 2);

const systems = [{"id":"ra-xsoc","index":"01","label":"FLAGSHIP SYSTEM","title":"RA-XSOC","short":"AI-assisted security investigation.","detail":"Retrieval, evidence correlation, MITRE mapping and structured investigation guidance — designed around traceability rather than generated text alone.","signal":"SECURITY / AI","href":"/projects/ra-xsoc/"},{"id":"sentinel","index":"02","label":"OPERATIONS","title":"SENTINEL","short":"Security operations in practice.","detail":"Detection, investigation, telemetry and defensive workflows that connect cybersecurity learning with operational thinking.","signal":"SOC / DEFENSE","href":"/projects/"},{"id":"cyber","index":"03","label":"FIELD","title":"CYBERSECURITY","short":"Labs, investigations and experiments.","detail":"A growing body of hands-on security work spanning networks, web security, digital forensics, OSINT and investigation design.","signal":"LAB / RESEARCH","href":"/projects/"}];

const discoverySteps = [
  ['01', 'DISCOVER', 'What is being built?'],
  ['02', 'TRACE', 'How does the system work?'],
  ['03', 'INSPECT', 'What evidence supports it?'],
  ['04', 'CONNECT', 'Where does it lead next?'],
];
---

<BaseLayout>
  <section class="gv-command-hero" aria-labelledby="gv-hero-title">
    <div class="gv-command-grid" aria-hidden="true"></div>
    <div class="gv-command-scan" aria-hidden="true"></div>
    <div class="container gv-command-inner">
      <div class="gv-command-copy" data-gv-reveal>
        <div class="gv-command-status"><span></span> GURUVERSE / INTRO</div>
        <p class="gv-command-intro">Hi, I'm <strong>Guru Charan.</strong></p>
        <p class="gv-command-kicker">AI × CYBERSECURITY × SYSTEMS</p>
        <h1 id="gv-hero-title">I build systems.<br /><em>Come see how they work.</em></h1>
        <p class="gv-command-lede">A living engineering portfolio by Guru Charan Mavuduru — where projects are not just displayed, they can be explored, traced and understood.</p>
        <div class="gv-command-actions">
          <a class="gv-command-primary" href="#systems"><span>ENTER THE SYSTEMS</span><Icon name="arrow" size={18} /></a>
          <a class="gv-command-secondary" href="/about/">WHO IS GURU CHARAN?</a>
        </div>
        <div class="gv-command-stats" aria-label="Current focus">
          <span><strong>AI</strong> applied intelligence</span>
          <span><strong>SEC</strong> defensive systems</span>
          <span><strong>BUILD</strong> engineering in public</span>
        </div>
      </div>

      <div class="gv-command-console" aria-label="Interactive GURUVERSE system navigator" data-system-console>
        <div class="gv-console-chrome">
          <span><i></i><i></i><i></i></span>
          <span>GURUVERSE / SYSTEM MAP</span>
          <span class="gv-console-live">LIVE</span>
        </div>
        <div class="gv-system-orbit">
          <div class="gv-orbit-ring gv-orbit-ring-a"></div>
          <div class="gv-orbit-ring gv-orbit-ring-b"></div>
          <div class="gv-orbit-line line-a"></div>
          <div class="gv-orbit-line line-b"></div>
          <div class="gv-core-node" aria-hidden="true"><span>GC</span><small>ENGINEER</small></div>
          {systems.map((system) => (
            <button class:list={['gv-system-orb', 'gv-system-orb-' + system.id, { active: system.id === 'ra-xsoc' }]} type="button" data-system={system.id} aria-pressed={system.id === 'ra-xsoc' ? 'true' : 'false'}>
              <span>{system.index}</span><strong>{system.title}</strong><small>{system.signal}</small>
            </button>
          ))}
        </div>
        <div class="gv-console-readout" aria-live="polite">
          <span class="gv-readout-label" data-readout-label>FLAGSHIP SYSTEM</span>
          <strong data-readout-title>RA-XSOC</strong>
          <p data-readout-short>AI-assisted security investigation.</p>
          <p class="gv-readout-detail" data-readout-detail>Retrieval, evidence correlation, MITRE mapping and structured investigation guidance — designed around traceability rather than generated text alone.</p>
          <a data-readout-link href="/projects/ra-xsoc/">OPEN SYSTEM <Icon name="arrow" size={15} /></a>
        </div>
      </div>
    </div>
    <div class="container gv-command-footer">
      <span>GURU CHARAN MAVUDURU</span>
      <span>AI &amp; DSE · CYBERSECURITY · ENGINEERING</span>
      <span>SCROLL / EXPLORE</span>
    </div>
  </section>

  <section class="gv-discovery section" aria-labelledby="discovery-title">
    <div class="container">
      <div class="gv-discovery-head" data-gv-reveal>
        <span class="gv-section-code">01 / HOW TO EXPLORE</span>
        <h2 id="discovery-title">Don't just read the portfolio.<br /><em>Follow the signal.</em></h2>
        <p>Every important part of GURUVERSE has a path deeper. Start with a system, trace its architecture, inspect the evidence, then see what it connects to.</p>
      </div>
      <div class="gv-discovery-rail">
        {discoverySteps.map(([index, title, text], i) => (
          <div class="gv-discovery-step" data-gv-reveal style={`--step-index:${i}`}>
            <span>{index}</span><div><strong>{title}</strong><p>{text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="systems" class="gv-systems section" aria-labelledby="systems-title" data-guru-context="Interactive system hangar — RA-XSOC, Sentinel and cybersecurity work.">
    <div class="container">
      <div class="gv-section-top" data-gv-reveal>
        <div><span class="gv-section-code">02 / SYSTEMS</span><h2 id="systems-title">The work is the showcase.</h2></div>
        <a class="gv-command-secondary" href="/projects/">ALL PROJECTS <Icon name="arrow" size={16} /></a>
      </div>
      <div class="gv-system-cards">
        {systems.map((system, index) => (
          <a class:list={['gv-system-card', { featured: index === 0 }]} href={system.href} data-gv-reveal>
            <div class="gv-system-card-top"><span>{system.index}</span><span>{system.signal}</span></div>
            <div class="gv-system-card-visual"><span class="gv-pulse"></span><span class="gv-card-node">{index === 0 ? 'RX' : index === 1 ? 'SN' : 'CY'}</span></div>
            <span class="gv-system-card-label">{system.label}</span>
            <h3>{system.title}</h3>
            <p>{system.detail}</p>
            <span class="gv-system-card-action">TRACE SYSTEM <Icon name="arrow" size={15} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="gv-proof section section-muted" aria-labelledby="proof-title">
    <div class="container">
      <div class="gv-proof-intro" data-gv-reveal>
        <span class="gv-section-code">03 / PROOF</span>
        <h2 id="proof-title">See the person behind the systems.</h2>
        <p>Engineering work has context. Follow the journey from learning to building, teaching and research.</p>
      </div>
      <div class="gv-proof-grid">
        <a class="gv-proof-tile" href="/experience/" data-gv-reveal><span>01 / JOURNEY</span><strong>Learning → building → teaching</strong><small>Trace the decisions and transitions behind the work.</small><Icon name="arrow" size={18} /></a>
        <a class="gv-proof-tile" href="/about/" data-gv-reveal><span>02 / PROFILE</span><strong>AI × cybersecurity × applied research</strong><small>Skills, education, focus areas and the direction ahead.</small><Icon name="arrow" size={18} /></a>
        <a class="gv-proof-tile" href="/resume/" data-gv-reveal><span>03 / PROFESSIONAL</span><strong>Inspect the professional profile</strong><small>{education[0].institution} · {experience[0].role}</small><Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="gv-featured section" aria-labelledby="featured-title">
    <div class="container">
      <div class="gv-section-top" data-gv-reveal>
        <div><span class="gv-section-code">04 / CASE STUDIES</span><h2 id="featured-title">Open the machinery.</h2></div>
        <p>Architecture, workflow, evidence and limitations — not just technology lists.</p>
      </div>
      <div class="gv-featured-grid">
        {featuredProjects.map((project) => <div data-gv-reveal><ProjectCard project={project} /></div>)}
      </div>
    </div>
  </section>

  <section class="gv-notes section section-muted" aria-labelledby="notes-title">
    <div class="container">
      <div class="gv-section-top" data-gv-reveal>
        <div><span class="gv-section-code">05 / FIELD NOTES</span><h2 id="notes-title">Thinking in public.</h2></div>
        <a class="gv-command-secondary" href="/blogs/">OPEN NOTEBOOK <Icon name="arrow" size={16} /></a>
      </div>
      <div class="gv-notes-grid">
        {featuredBlogs.map((post) => (
          <a class="gv-note-card" data-gv-reveal href={`/blogs/${post.id}/`}>
            <span>{post.data.domain} · {post.data.publishedAt.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })}</span>
            <h3>{post.data.title}</h3><p>{post.data.description}</p><strong>READ FIELD NOTE <Icon name="arrow" size={15} /></strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="gv-finale section" aria-labelledby="finale-title">
    <div class="container gv-finale-inner" data-gv-reveal>
      <span class="gv-section-code">06 / CONTINUE</span>
      <h2 id="finale-title">There is more<br /><em>under the surface.</em></h2>
      <p>Explore a system. Follow the evidence. Then come back and find another.</p>
      <div class="gv-command-actions"><a class="gv-command-primary" href="/projects/">EXPLORE ALL SYSTEMS <Icon name="arrow" size={18} /></a><a class="gv-command-secondary" href="/contact/">SAY HELLO</a></div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveal = [...document.querySelectorAll('[data-gv-reveal]')];
      if (reduced || !('IntersectionObserver' in window)) reveal.forEach((el) => el.classList.add('is-visible'));
      else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          });
        }, { threshold: .08 });
        reveal.forEach((el) => observer.observe(el));
      }

      const systems = [{"id":"ra-xsoc","index":"01","label":"FLAGSHIP SYSTEM","title":"RA-XSOC","short":"AI-assisted security investigation.","detail":"Retrieval, evidence correlation, MITRE mapping and structured investigation guidance — designed around traceability rather than generated text alone.","signal":"SECURITY / AI","href":"/projects/ra-xsoc/"},{"id":"sentinel","index":"02","label":"OPERATIONS","title":"SENTINEL","short":"Security operations in practice.","detail":"Detection, investigation, telemetry and defensive workflows that connect cybersecurity learning with operational thinking.","signal":"SOC / DEFENSE","href":"/projects/"},{"id":"cyber","index":"03","label":"FIELD","title":"CYBERSECURITY","short":"Labs, investigations and experiments.","detail":"A growing body of hands-on security work spanning networks, web security, digital forensics, OSINT and investigation design.","signal":"LAB / RESEARCH","href":"/projects/"}];
      const buttons = [...document.querySelectorAll('[data-system]')];
      const label = document.querySelector('[data-readout-label]');
      const title = document.querySelector('[data-readout-title]');
      const short = document.querySelector('[data-readout-short]');
      const detail = document.querySelector('[data-readout-detail]');
      const link = document.querySelector('[data-readout-link]');
      const select = (id) => {
        const system = systems.find((item) => item.id === id);
        if (!system) return;
        buttons.forEach((button) => {
          const active = button.dataset.system === id;
          button.classList.toggle('active', active);
          button.setAttribute('aria-pressed', String(active));
        });
        if (label) label.textContent = system.label;
        if (title) title.textContent = system.title;
        if (short) short.textContent = system.short;
        if (detail) detail.textContent = system.detail;
        if (link) link.href = system.href;
      };
      buttons.forEach((button) => button.addEventListener('click', () => select(button.dataset.system)));

      if (!reduced && window.matchMedia('(pointer: fine)').matches) {
        const consoleEl = document.querySelector('[data-system-console]');
        consoleEl?.addEventListener('pointermove', (event) => {
          const rect = consoleEl.getBoundingClientRect();
          consoleEl.style.setProperty('--mx', ((event.clientX - rect.left) / rect.width * 100).toFixed(2) + '%');
          consoleEl.style.setProperty('--my', ((event.clientY - rect.top) / rect.height * 100).toFixed(2) + '%');
        });
        consoleEl?.addEventListener('pointerleave', () => { consoleEl.style.removeProperty('--mx'); consoleEl.style.removeProperty('--my'); });
      }
    })();
  </script>
</BaseLayout>
