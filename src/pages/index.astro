---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../features/projects/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import heroImage from '../assets/images/guru-charan-hero.webp';
import { education, experience } from '../data/profile';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 4);
const blogs = (await getCollection('blogs', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredBlogs = blogs.filter((post) => post.data.featured).slice(0, 2);

const projectSignals = [
  { label: 'SECURITY', title: 'Systems that investigate', text: 'SOC workflows, evidence, detection and response.', icon: 'shield', href: '/projects/' },
  { label: 'AI', title: 'Intelligence with evidence', text: 'Retrieval, embeddings and explainable decision support.', icon: 'brain', href: '/projects/' },
  { label: 'PRODUCT', title: 'Ideas made usable', text: 'Learning platforms, automation and practical systems.', icon: 'workflow', href: '/projects/' },
];

const systemNodes = [
  { code: '01', title: 'Research', text: 'Questions, experiments and technical investigation.' },
  { code: '02', title: 'Systems', text: 'Architecture, implementation and engineering decisions.' },
  { code: '03', title: 'Evidence', text: 'Results, limitations, repositories and documentation.' },
  { code: '04', title: 'Evolution', text: 'What changed, what failed and what comes next.' },
];
---

<BaseLayout>
  <section class="gv-hero" data-guru-context="GURUVERSE command deck — identity, direction and the beginning of the engineering journey.">
    <div class="gv-hero-grid" aria-hidden="true"></div>
    <div class="gv-hero-glow gv-hero-glow-a" aria-hidden="true"></div>
    <div class="gv-hero-glow gv-hero-glow-b" aria-hidden="true"></div>
    <div class="container gv-hero-inner">
      <div class="gv-hero-copy reveal" data-reveal>
        <div class="gv-eyebrow"><span class="gv-live-dot"></span> GURUVERSE / ENGINEERING PORTFOLIO</div>
        <p class="gv-hero-kicker">AI × CYBERSECURITY × SYSTEMS</p>
        <h1>Building systems.<br /><em>Showing how they work.</em></h1>
        <p class="gv-hero-lede">I’m Guru Charan — an AI&DSE postgraduate student, cybersecurity practitioner-in-training and builder documenting the path from idea to working system.</p>
        <div class="gv-hero-actions">
          <a class="gv-primary-action" href="#work">Enter the work <Icon name="arrow" size={18} /></a>
          <a class="gv-text-action" href="/about/">Understand the person <Icon name="arrow" size={16} /></a>
        </div>
        <div class="gv-hero-metrics" aria-label="Portfolio focus">
          <span><strong>AI</strong> applied intelligence</span>
          <span><strong>SEC</strong> defensive engineering</span>
          <span><strong>BUILD</strong> practical systems</span>
        </div>
      </div>
      <div class="gv-hero-visual reveal" data-reveal>
        <div class="gv-portrait-shell" data-tilt>
          <div class="gv-portrait-frame">
            <Image src={heroImage} alt="Guru Charan Mavuduru" widths={[520, 760, 960]} sizes="(max-width: 900px) 72vw, 34vw" loading="eager" fetchpriority="high" />
          </div>
          <div class="gv-orbit gv-orbit-one" aria-hidden="true"></div>
          <div class="gv-orbit gv-orbit-two" aria-hidden="true"></div>
          <div class="gv-portrait-label"><span>NOW</span><strong>M.Tech AI&DSE</strong><small>IIT Patna · 2026—</small></div>
        </div>
        <div class="gv-floating-note gv-floating-note-a"><span>BUILDING</span><strong>RA-XSOC</strong></div>
        <div class="gv-floating-note gv-floating-note-b"><span>EXPLORING</span><strong>AI × Security</strong></div>
      </div>
    </div>
    <div class="container gv-scroll-cue" aria-hidden="true"><span>SCROLL TO EXPLORE</span><i></i></div>
  </section>

  <section class="gv-orientation section" aria-labelledby="orientation-title">
    <div class="container">
      <div class="gv-section-intro reveal" data-reveal>
        <div><span class="gv-section-code">01 / ORIENTATION</span><h2 id="orientation-title">This is more than a list of projects.</h2></div>
        <p>GURUVERSE connects the person, the systems he builds and the evidence behind them. Explore by what you want to understand—not by a fixed portfolio checklist.</p>
      </div>
      <div class="gv-signal-grid">
        {projectSignals.map((signal, index) => (
          <a class="gv-signal-card reveal" data-reveal href={signal.href} style={`--signal-index:${index}`}>
            <div class="gv-signal-top"><span>0{index + 1}</span><Icon name={signal.icon} size={22} /></div>
            <span class="gv-signal-label">{signal.label}</span>
            <h3>{signal.title}</h3><p>{signal.text}</p>
            <span class="gv-card-arrow"><Icon name="arrow" size={17} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="gv-system section section-muted" aria-labelledby="system-title">
    <div class="container">
      <div class="gv-system-header reveal" data-reveal>
        <div><span class="gv-section-code">02 / THE METHOD</span><h2 id="system-title">Follow the engineering, not the decoration.</h2></div>
        <p>Every serious project follows a visible trail from question to evidence to its next version.</p>
      </div>
      <div class="gv-system-map" aria-label="GURUVERSE engineering method">
        {systemNodes.map((node, index) => (
          <div class="gv-system-node reveal" data-reveal style={`--node-index:${index}`}>
            <span class="gv-node-code">{node.code}</span><div><strong>{node.title}</strong><p>{node.text}</p></div>
            {index < systemNodes.length - 1 && <span class="gv-node-connector" aria-hidden="true"></span>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="work" class="gv-work section" data-guru-context="Project hangar — selected engineering systems and research.">
    <div class="container">
      <div class="gv-work-header reveal" data-reveal>
        <div><span class="gv-section-code">03 / SELECTED SYSTEMS</span><h2>Open a project.<br /><em>Go deeper.</em></h2></div>
        <div><p>Each case study exposes architecture, workflow, evidence and limitations—not just a polished outcome.</p><a class="gv-text-action" href="/projects/">View all systems <Icon name="arrow" size={16} /></a></div>
      </div>
      <div class="gv-featured-grid">
        {featuredProjects.map((project, index) => (
          <div class:list={['gv-project-slot', `gv-project-slot-${index + 1}`, 'reveal']} data-reveal><ProjectCard project={project} /></div>
        ))}
      </div>
    </div>
  </section>

  <section class="gv-proof section" aria-labelledby="proof-title">
    <div class="container"><div class="gv-proof-grid">
      <div class="gv-proof-copy reveal" data-reveal>
        <span class="gv-section-code">04 / EVIDENCE</span><h2 id="proof-title">I want the work to be inspectable.</h2>
        <p>Projects are deliberately separated by maturity: functional system, research prototype, active development or planned direction. The goal is credibility through clarity.</p>
        <div class="gv-proof-links">
          <a href="/projects/">Inspect project evidence <Icon name="arrow" size={16} /></a>
          <a href="/experience/">Trace the career journey <Icon name="arrow" size={16} /></a>
          <a href="/resume/">Open the professional profile <Icon name="arrow" size={16} /></a>
        </div>
      </div>
      <div class="gv-proof-stack reveal" data-reveal>
        <article><span>STUDYING</span><strong>{education[0].qualification}</strong><small>{education[0].institution}</small></article>
        <article><span>WORKING</span><strong>{experience[0].role}</strong><small>{experience[0].organisation}</small></article>
        <article><span>BUILDING</span><strong>AI-assisted security systems</strong><small>RA-XSOC · CyberGPT · practical SOC research</small></article>
        <article><span>TEACHING</span><strong>Technology through practice</strong><small>Python · HTML · CSS · cybersecurity learning</small></article>
      </div>
    </div></div>
  </section>

  <section class="gv-notes section section-muted" aria-labelledby="notes-title">
    <div class="container">
      <div class="gv-notes-header reveal" data-reveal>
        <div><span class="gv-section-code">05 / FIELD NOTES</span><h2 id="notes-title">The thinking behind the builds.</h2></div>
        <a class="gv-text-action" href="/blogs/">Open the notebook <Icon name="arrow" size={16} /></a>
      </div>
      <div class="gv-notes-grid">
        {featuredBlogs.map((post, index) => (
          <a class="gv-note-card reveal" data-reveal href={`/blogs/${post.id}/`} style={`--note-index:${index}`}>
            <span>{post.data.domain} · {post.data.publishedAt.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })}</span>
            <h3>{post.data.title}</h3><p>{post.data.description}</p><strong>Read field note <Icon name="arrow" size={16} /></strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="gv-finale section" data-guru-context="The next chapter — connect with Guru Charan or continue exploring the engineering work.">
    <div class="container gv-finale-inner reveal" data-reveal>
      <span class="gv-section-code">06 / NEXT CHAPTER</span>
      <h2>The universe gets bigger<br /><em>as the work gets deeper.</em></h2>
      <p>GURUVERSE will eventually add project worlds, intelligent navigation and GURU-BOT. The foundation stays the same: useful work, visible reasoning and honest evidence.</p>
      <div class="gv-hero-actions"><a class="gv-primary-action" href="/contact/">Start a conversation <Icon name="arrow" size={18} /></a><a class="gv-text-action" href="/about/">See the architecture <Icon name="arrow" size={16} /></a></div>
    </div>
  </section>
</BaseLayout>
