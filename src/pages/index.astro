---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import LiveBlogGrid from '../components/LiveBlogGrid.astro';
import SecurityCore from '../components/SecurityCore.astro';
import ArchitectureExplorer from '../components/ArchitectureExplorer.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import aboutImage from '../assets/images/guru-charan-about.webp';
import { education, experience } from '../data/profile';
import { journey } from '../data/journey';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const flagshipIds = ['cybergpt', 'soc-home-lab', 'sahaaya360', 'osprey-mppt', 'portfolio-v2'];
const featuredProjects = flagshipIds
  .map((id) => projects.find((project) => project.id === id))
  .filter(Boolean);
const blogs = (await getCollection('blogs', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredBlogs = blogs.filter((post) => post.data.featured).slice(0, 3);
---

<BaseLayout>
  <div class="v4-intro" data-v4-intro>
    <div class="v4-intro-grid"></div>
    <div class="v4-intro-copy">
      <span>GC / PORTFOLIO SYSTEM</span>
      <strong data-intro-status>Initialising identity layer</strong>
      <div class="v4-intro-progress"><i data-intro-progress></i></div>
      <button type="button" data-intro-skip>Skip intro</button>
    </div>
  </div>

  <section class="v4-hero section-shell" aria-labelledby="v4-hero-title">
    <div class="v4-hero-noise" aria-hidden="true"></div>
    <div class="container v4-hero-grid">
      <div class="v4-hero-copy reveal" data-reveal>
        <div class="v4-status-line">
          <span><i></i> Open to AI-security and SOC opportunities</span>
          <span>Andhra Pradesh · India</span>
        </div>

        <p class="v4-hero-kicker">Hello, I’m Guru Charan Mavuduru.</p>
        <h1 id="v4-hero-title">
          I turn security signals into
          <span>clearer decisions.</span>
        </h1>
        <p class="v4-hero-description">
          I am an M.Tech AI &amp; Data Science Engineering student at IIT Patna,
          a computer teacher and a hands-on cybersecurity builder. My work sits
          between SOC engineering, retrieval systems and explainable AI.
        </p>

        <div class="v4-hero-actions">
          <a class="button button-primary" href="#flagship-projects">
            Enter my work <Icon name="arrow" size={18} />
          </a>
          <a class="button button-secondary" href="/about/">Trace my journey</a>
          <a class="v4-text-action" href="/contact/"><Icon name="mail" size={17} /> Start a conversation</a>
        </div>

        <div class="v4-role-switcher" aria-label="Current professional directions">
          <span>Current direction</span>
          <strong data-role-switcher>AI Security Engineering</strong>
        </div>

        <SocialLinks compact={false} />
      </div>

      <div class="v4-hero-core reveal" data-reveal>
        <SecurityCore />
      </div>
    </div>

    <div class="container v4-signal-strip reveal" data-reveal>
      <article>
        <span>01 / Analyse</span>
        <strong>SOC telemetry</strong>
        <p>Logs, alerts and indicators become evidence—not noise to be hidden.</p>
      </article>
      <article>
        <span>02 / Retrieve</span>
        <strong>Relevant knowledge</strong>
        <p>Embeddings and structured playbooks connect a new incident with useful context.</p>
      </article>
      <article>
        <span>03 / Explain</span>
        <strong>Human-readable reasoning</strong>
        <p>Confidence, limitations and next actions stay visible to the analyst.</p>
      </article>
      <article>
        <span>04 / Improve</span>
        <strong>Learning in public</strong>
        <p>Failures, fixes and decisions are documented—not erased from the story.</p>
      </article>
    </div>
  </section>

  <section class="section v4-manifesto" id="journey">
    <div class="container v4-manifesto-grid">
      <div class="v4-manifesto-heading reveal" data-reveal>
        <span class="eyebrow">The human behind the system</span>
        <h2>I did not start in cybersecurity. I followed the problems that kept pulling me deeper.</h2>
      </div>
      <div class="v4-manifesto-copy reveal" data-reveal>
        <p>
          Electrical engineering taught me systems. Web development taught me to
          build. Cybersecurity taught me to question evidence. Teaching taught me
          to explain. AI is now helping me connect all four.
        </p>
        <blockquote>
          I want to build security tools that are useful enough for an analyst,
          honest enough to show uncertainty and clear enough for another learner
          to understand.
        </blockquote>
        <a class="text-link" href="/about/">Read the complete story <Icon name="arrow" size={17} /></a>
      </div>
    </div>

    <div class="container v4-journey-console reveal" data-reveal>
      <div class="v4-console-head">
        <span><i></i><i></i><i></i></span>
        <strong>career-path.log</strong>
        <small>scroll to inspect</small>
      </div>
      <div class="v4-journey-track">
        {journey.map((item, index) => (
          <article class="v4-journey-entry">
            <div class="v4-journey-marker"><span>{String(index + 1).padStart(2, '0')}</span></div>
            <div class="v4-journey-period">{item.period}</div>
            <div class="v4-journey-content">
              <span>{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
            <div class="v4-journey-signal">{item.signal}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section v4-domains" aria-labelledby="domains-title">
    <div class="container">
      <SectionHeading
        eyebrow="What I am building toward"
        title="Three disciplines. One direction."
        description="The strongest work happens where security operations, AI reasoning and practical engineering meet. Select a discipline to see how it changes the system."
      />
      <div class="v4-domain-system" data-domain-system>
        <div class="v4-domain-controls" role="tablist" aria-label="Professional focus areas">
          <button class="active" type="button" role="tab" aria-selected="true" data-domain-button="security">
            <span>01</span><strong>AI Security Engineering</strong><small>Reasoning, safety and analyst support</small>
          </button>
          <button type="button" role="tab" aria-selected="false" data-domain-button="soc">
            <span>02</span><strong>SOC Engineering</strong><small>Detection, investigation and response</small>
          </button>
          <button type="button" role="tab" aria-selected="false" data-domain-button="data">
            <span>03</span><strong>Applied AI &amp; Data</strong><small>Retrieval, analysis and research</small>
          </button>
        </div>
        <div class="v4-domain-display">
          <div class="v4-domain-orbit" aria-hidden="true">
            <span class="v4-domain-center">AI × SOC</span>
            <i data-domain-orbit-label="one">Explain</i>
            <i data-domain-orbit-label="two">Verify</i>
            <i data-domain-orbit-label="three">Assist</i>
          </div>
          <div class="v4-domain-copy" aria-live="polite">
            <span data-domain-kicker>Current target</span>
            <h3 data-domain-title>Build AI that supports security decisions without hiding the reasoning.</h3>
            <p data-domain-description>My focus is not replacing analysts. It is reducing repetitive work, surfacing relevant context and making confidence and limitations visible.</p>
            <ul data-domain-list>
              <li>Retrieval-augmented incident response</li>
              <li>Explainable recommendations</li>
              <li>Safe approval-based automation</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section v4-project-section" id="flagship-projects">
    <div class="container">
      <div class="section-row v4-section-row">
        <SectionHeading
          eyebrow="Flagship work"
          title="Projects shown as decisions, evidence and unfinished questions"
          description="These are not polished marketing cards. Each case study explains the problem, architecture, current proof, limitations and next engineering step."
        />
        <a class="text-link section-link" href="/projects/">View all projects <Icon name="arrow" size={17} /></a>
      </div>
      <ProjectShowcase projects={featuredProjects} />
    </div>
  </section>

  <section class="section v4-architecture-section">
    <div class="container v4-architecture-heading">
      <div class="reveal" data-reveal>
        <span class="eyebrow">Interactive architecture</span>
        <h2>Inside CyberGPT: from incident narrative to analyst guidance</h2>
      </div>
      <p class="reveal" data-reveal>
        Select each stage to inspect the input, output and purpose. The goal is
        not a mysterious AI answer—it is a traceable decision-support workflow.
      </p>
    </div>
    <div class="container reveal" data-reveal>
      <ArchitectureExplorer />
    </div>
  </section>

  <section class="section v4-now-section">
    <div class="container v4-now-grid">
      <div class="v4-now-portrait reveal" data-reveal data-tilt>
        <Image
          src={aboutImage}
          alt="Guru Charan Mavuduru in an earlier portrait"
          widths={[420, 640, 840]}
          sizes="(max-width: 820px) 86vw, 34vw"
        />
        <div class="v4-now-portrait-label">
          <span>Not a finished profile</span>
          <strong>A career under active construction</strong>
        </div>
      </div>
      <div class="v4-now-copy reveal" data-reveal>
        <span class="eyebrow">Current operating state</span>
        <h2>This portfolio changes as the work becomes real.</h2>
        <p>
          I am balancing postgraduate study, teaching, SOC practice and project
          development. Some systems are functional prototypes; some are still
          being tested. I label that honestly because progress is more useful
          than pretending every experiment is production-ready.
        </p>
        <div class="v4-now-list">
          <article><span>Studying</span><strong>{education[0].qualification}</strong><small>{education[0].institution}</small></article>
          <article><span>Working as</span><strong>{experience[0].role}</strong><small>{experience[0].organisation}</small></article>
          <article><span>Building</span><strong>RA-XSOC / CyberGPT V2</strong><small>Modular retrieval and analyst-support engineering</small></article>
          <article><span>Exploring</span><strong>Agent reliability and self-healing AI</strong><small>PRISM-Agent research direction</small></article>
        </div>
      </div>
    </div>
  </section>

  <section class="section v4-journal-section">
    <div class="container">
      <div class="section-row v4-section-row">
        <SectionHeading
          eyebrow="Live learning journal"
          title="The writing layer updates from Google Drive"
          description="Project reflections, mistakes, architecture notes and learning series can appear here without rebuilding the website. The portfolio remains code; the journal remains easy to write."
        />
        <a class="text-link section-link" href="/blogs/">Open the complete journal <Icon name="arrow" size={17} /></a>
      </div>
      <LiveBlogGrid posts={featuredBlogs} limit={3} />
    </div>
  </section>

  <section class="section v4-contact-portal">
    <div class="container v4-contact-grid reveal" data-reveal>
      <div>
        <span class="eyebrow">Open channel</span>
        <h2>Have a security problem, role or project that matches this direction?</h2>
        <p>
          I am interested in SOC Analyst, Cybersecurity Analyst, AI-for-security,
          technical education and meaningful collaboration opportunities.
        </p>
      </div>
      <div class="v4-contact-terminal">
        <span>&gt; connection.status</span>
        <strong>READY FOR A THOUGHTFUL CONVERSATION</strong>
        <small>Tell me the context, expected outcome and why my work felt relevant.</small>
        <div>
          <a class="button button-primary" href="/contact/">Send a secure message <Icon name="arrow" size={18} /></a>
          <a class="button button-secondary" href="/resume/">Review my resume</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const intro = document.querySelector('[data-v4-intro]');
      if (intro) {
        const seen = sessionStorage.getItem('gc-v4-intro-seen');
        const statuses = [
          'Initialising identity layer',
          'Connecting security projects',
          'Synchronising learning journal',
          'Portfolio system ready',
        ];
        const status = intro.querySelector('[data-intro-status]');
        const progress = intro.querySelector('[data-intro-progress]');
        let timer = 0;

        const close = () => {
          window.clearInterval(timer);
          intro.classList.add('is-complete');
          sessionStorage.setItem('gc-v4-intro-seen', 'true');
          window.setTimeout(() => intro.remove(), 700);
        };

        intro.querySelector('[data-intro-skip]')?.addEventListener('click', close);

        if (seen || reduced) {
          intro.remove();
        } else {
          let step = 0;
          timer = window.setInterval(() => {
            step += 1;
            if (progress) progress.style.transform = `scaleX(${Math.min(1, step / statuses.length)})`;
            if (status) status.textContent = statuses[Math.min(step, statuses.length - 1)];
            if (step >= statuses.length) window.setTimeout(close, 250);
          }, 420);
        }
      }

      const roles = ['AI Security Engineering', 'SOC Engineering', 'Applied AI & Data Science', 'Technical Education'];
      const role = document.querySelector('[data-role-switcher]');
      if (role && !reduced) {
        let index = 0;
        window.setInterval(() => {
          role.classList.add('is-changing');
          window.setTimeout(() => {
            index = (index + 1) % roles.length;
            role.textContent = roles[index];
            role.classList.remove('is-changing');
          }, 180);
        }, 2800);
      }

      const domainRoot = document.querySelector('[data-domain-system]');
      if (domainRoot) {
        const domainData = {
          security: {
            kicker: 'Current target',
            title: 'Build AI that supports security decisions without hiding the reasoning.',
            description: 'My focus is not replacing analysts. It is reducing repetitive work, surfacing relevant context and making confidence and limitations visible.',
            items: ['Retrieval-augmented incident response', 'Explainable recommendations', 'Safe approval-based automation'],
            orbit: ['Explain', 'Verify', 'Assist'],
          },
          soc: {
            kicker: 'Defensive foundation',
            title: 'Engineer the detection and investigation workflow around real evidence.',
            description: 'SOC work gives the AI layer a practical purpose: logs, alerts, hypotheses, playbooks and human decisions must connect without losing traceability.',
            items: ['SIEM use cases and log analysis', 'Incident investigation and triage', 'Home-lab simulation and detection'],
            orbit: ['Detect', 'Investigate', 'Respond'],
          },
          data: {
            kicker: 'Research engine',
            title: 'Use data and retrieval methods to make complex systems easier to inspect.',
            description: 'Embeddings, FAISS, Python analysis and optimisation are tools for structuring uncertainty—not decorations added to a project title.',
            items: ['Embeddings and semantic retrieval', 'Data analysis and evaluation', 'Optimisation and research prototyping'],
            orbit: ['Model', 'Measure', 'Improve'],
          },
        };
        const buttons = [...domainRoot.querySelectorAll('[data-domain-button]')];
        const title = domainRoot.querySelector('[data-domain-title]');
        const kicker = domainRoot.querySelector('[data-domain-kicker]');
        const description = domainRoot.querySelector('[data-domain-description]');
        const list = domainRoot.querySelector('[data-domain-list]');
        const orbitLabels = [
          domainRoot.querySelector('[data-domain-orbit-label="one"]'),
          domainRoot.querySelector('[data-domain-orbit-label="two"]'),
          domainRoot.querySelector('[data-domain-orbit-label="three"]'),
        ];

        buttons.forEach((button) => button.addEventListener('click', () => {
          const key = button.dataset.domainButton;
          const data = domainData[key];
          if (!data) return;
          buttons.forEach((candidate) => {
            const active = candidate === button;
            candidate.classList.toggle('active', active);
            candidate.setAttribute('aria-selected', String(active));
          });
          kicker.textContent = data.kicker;
          title.textContent = data.title;
          description.textContent = data.description;
          list.innerHTML = data.items.map((item) => `<li>${item}</li>`).join('');
          orbitLabels.forEach((label, index) => { if (label) label.textContent = data.orbit[index]; });
          domainRoot.dataset.activeDomain = key;
        }));
      }
    })();
  </script>
</BaseLayout>
