---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../features/projects/ProjectCard.astro';
import Icon from '../components/Icon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 3);
const blogs = (await getCollection('blogs', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredBlogs = blogs.filter((post) => post.data.featured).slice(0, 2);
---

<BaseLayout>
  <main class="gv-home-v2">
    <section class="gv-v2-hero" aria-labelledby="v2-title">
      <div class="gv-v2-rail" aria-hidden="true">
        <span>GURUVERSE</span><i></i><span>AI / SEC / BUILD</span>
      </div>
      <div class="gv-v2-noise" aria-hidden="true"></div>
      <div class="container gv-v2-hero-grid">
        <div class="gv-v2-hero-copy">
          <p class="gv-v2-overline"><b></b> ENGINEER / RESEARCHER / EDUCATOR</p>
          <p class="gv-v2-hello">Hi, I'm Guru Charan.</p>
          <h1 id="v2-title"><span>GURU</span><span>CHARAN</span></h1>
          <div class="gv-v2-rule"><span></span><strong>01</strong><small>OPEN SYSTEMS. UNDERSTAND THEM.</small></div>
          <p class="gv-v2-manifesto">I build AI and cybersecurity systems to understand complex problems, prove what I learn, and make difficult technology easier to explain.</p>
          <div class="gv-v2-actions">
            <a class="gv-v2-primary" href="#work">ENTER THE WORK <Icon name="arrow" size={17} /></a>
            <a class="gv-v2-textlink" href="/about/">READ THE STORY <span>↗</span></a>
          </div>
        </div>
        <div class="gv-v2-observer">
          <div class="gv-v2-observer-head"><span>OBSERVATORY / 001</span><span>LIVE</span></div>
          <div class="gv-v2-orbit">
            <div class="gv-v2-orbit-ring ring-1"></div>
            <div class="gv-v2-orbit-ring ring-2"></div>
            <div class="gv-v2-orbit-ring ring-3"></div>
            <div class="gv-v2-sun"><b>GC</b><small>ENGINEERING</small></div>
            <span class="gv-v2-satellite sat-a">AI</span>
            <span class="gv-v2-satellite sat-b">SEC</span>
            <span class="gv-v2-satellite sat-c">DSE</span>
          </div>
          <div class="gv-v2-observer-readout">
            <span>CURRENT VECTOR</span>
            <strong>AI × SECURITY</strong>
            <p>Building systems that retrieve evidence, connect signals and explain what happened.</p>
          </div>
          <div class="gv-v2-microgrid"><span>LAT / BUILD</span><span>MODE / RESEARCH</span><span>STATE / ACTIVE</span></div>
        </div>
      </div>
      <div class="container gv-v2-scroll"><span>SCROLL TO INVESTIGATE</span><i></i></div>
    </section>

    <section class="gv-v2-statement" aria-label="Engineering philosophy">
      <div class="container gv-v2-statement-grid">
        <span class="gv-v2-section-no">02</span>
        <h2>Curiosity became a method.</h2>
        <p>Machines → internet → cybersecurity → AI. I keep asking the same question: <em>what is happening underneath?</em></p>
      </div>
    </section>

    <section id="work" class="gv-v2-work section" aria-labelledby="work-title">
      <div class="container">
        <div class="gv-v2-section-head">
          <div><span class="gv-v2-section-no">03 / THE WORK</span><h2 id="work-title">Built to be inspected.</h2></div>
          <p>Projects are evidence of learning — not decoration.</p>
        </div>
        <div class="gv-v2-projects">
          {featuredProjects.map((project, index) => (
            <a class:list={['gv-v2-project', { 'is-main': index === 0 }]} href={`/projects/${project.id}/`} data-reveal>
              <div class="gv-v2-project-index">0{index + 1}</div>
              <div class="gv-v2-project-visual"><span>{index === 0 ? 'RX' : index === 1 ? 'AI' : 'SQ'}</span><i></i></div>
              <div class="gv-v2-project-body">
                <span>{project.data.domain} / {project.data.status}</span>
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                <strong>OPEN CASE STUDY <Icon name="arrow" size={15} /></strong>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="gv-v2-evolution section" aria-labelledby="evolution-title">
      <div class="container gv-v2-evolution-grid">
        <div>
          <span class="gv-v2-section-no">04 / EVOLUTION</span>
          <h2 id="evolution-title">One project became another.</h2>
          <p>CyberGPT started as an attempt to understand security assistance. It evolved into RA-XSOC — a more evidence-driven direction for security investigation.</p>
        </div>
        <div class="gv-v2-evolution-map" aria-label="CyberGPT to RA-XSOC evolution">
          <div><span>ORIGIN</span><strong>CYBERGPT</strong><small>Retrieval · playbooks · MITRE</small></div>
          <i>→</i>
          <div class="active"><span>EVOLUTION</span><strong>RA-XSOC</strong><small>Evidence · correlation · investigation</small></div>
        </div>
      </div>
    </section>

    <section class="gv-v2-proof section" aria-labelledby="proof-title">
      <div class="container">
        <div class="gv-v2-section-head">
          <div><span class="gv-v2-section-no">05 / PROOF</span><h2 id="proof-title">What sits behind the work.</h2></div>
        </div>
        <div class="gv-v2-proof-grid">
          <a href="/about/"><span>IDENTITY</span><strong>AI × Cybersecurity × Research</strong><small>The person, skills and direction.</small></a>
          <a href="/experience/"><span>JOURNEY</span><strong>Learning → building → teaching</strong><small>The path that shaped the systems.</small></a>
          <a href="/blogs/"><span>FIELD NOTES</span><strong>Thinking in public</strong><small>Experiments, research and lessons.</small></a>
          <a href="/resume/"><span>PROFESSIONAL</span><strong>Inspect the résumé</strong><small>Education, experience and capabilities.</small></a>
        </div>
      </div>
    </section>

    <section class="gv-v2-notes section" aria-labelledby="notes-title">
      <div class="container">
        <div class="gv-v2-section-head">
          <div><span class="gv-v2-section-no">06 / NOTES</span><h2 id="notes-title">Still learning.</h2></div>
          <a class="gv-v2-textlink" href="/blogs/">ALL NOTES ↗</a>
        </div>
        <div class="gv-v2-notes-grid">
          {featuredBlogs.map((post) => (
            <a href={`/blogs/${post.id}/`} data-reveal>
              <span>{post.data.domain} · {post.data.publishedAt.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <strong>READ ↗</strong>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="gv-v2-end" aria-labelledby="end-title">
      <div class="container">
        <span class="gv-v2-section-no">07 / NEXT</span>
        <h2 id="end-title">Independent<br /><em>AI security engineer.</em></h2>
        <p>And an author. Build systems. Understand them. Explain them.</p>
        <a class="gv-v2-primary" href="/contact/">START A CONVERSATION <Icon name="arrow" size={17} /></a>
      </div>
    </section>
  </main>
</BaseLayout>
