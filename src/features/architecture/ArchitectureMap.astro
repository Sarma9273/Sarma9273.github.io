---
import { guruverseArchitecture } from '../data/architecture';
---
<section class="architecture-section" aria-labelledby="architecture-title">
  <div class="container">
    <div class="architecture-heading">
      <div><span class="eyebrow">How GURUVERSE is built</span><h2 id="architecture-title">A layered system, not a pile of effects.</h2></div>
      <p>Every interactive layer has a job. If an effect does not improve discovery, understanding or evidence, it stays out of the way.</p>
    </div>
    <div class="architecture-stack">
      {guruverseArchitecture.map((layer) => (
        <article class="architecture-layer">
          <span>{layer.label}</span>
          <div><h3>{layer.title}</h3><p>{layer.description}</p></div>
          <ul>{layer.capabilities.map((item) => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>
