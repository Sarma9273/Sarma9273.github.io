---
interface Props { title:string; domain:string; description:string; technologies:string[]; architecture?:string[]; evidence?:string[]; metrics?:string[]; }
const { title, domain, description, technologies, architecture = [], evidence = [], metrics = [] } = Astro.props;
const steps = architecture.length ? architecture.slice(0,7) : ['INPUT','INTELLIGENCE','DECISION','EVIDENCE','OUTCOME'];
---
<section class="project-world" data-project-world data-guru-context={`PROJECT WORLD — ${title} interactive architecture.`} aria-label={`${title} project world`}>
  <div class="project-world-stars" aria-hidden="true"></div>
  <div class="project-world-head"><span class="eyebrow">PROJECT WORLD · {domain}</span><h2>{title}</h2><p>{description}</p></div>
  <div class="project-world-meter" aria-hidden="true"><span data-project-meter></span></div>
  <div class="project-orbit" aria-label="Project architecture flow">
    <div class="project-core"><span>PROJECT SYSTEM</span><strong>PROJECT<br />CORE</strong></div>
    {steps.map((step,index)=><button type="button" class="project-node" style={`--node:${index}`} data-project-node data-step={step}><span>0{index+1}</span><strong>{step}</strong></button>)}
    <div class="project-beam project-beam-a"></div><div class="project-beam project-beam-b"></div>
  </div>
  <div class="project-world-panel" data-project-panel><span data-project-panel-label>PROJECT SIGNAL</span><strong data-project-panel-title>Choose an architecture layer</strong><p data-project-panel-copy>Use the nodes to inspect how this project moves from problem to evidence.</p></div>
  <div class="project-tech-strip"><span>STACK</span>{technologies.slice(0,8).map((tech)=><b>{tech}</b>)}</div>
  {(metrics.length > 0 || evidence.length > 0) && <div class="project-proof-strip">
    {metrics.length > 0 && <div><span>MEASURED / DOCUMENTED</span><strong>{metrics[0]}</strong></div>}
    {evidence.length > 0 && <div><span>EVIDENCE</span><strong>{evidence[0]}</strong></div>}
  </div>}
</section>
<script define:vars={{ title, steps }}>
(()=>{const root=document.querySelector('[data-project-world]');if(!(root instanceof HTMLElement))return;const copy={};steps.forEach((step,index)=>{copy[step]=[step,'Architecture layer '+(index+1),'Inspect how '+step.toLowerCase()+' contributes to the '+title+' system.']});const label=root.querySelector('[data-project-panel-label]');const panelTitle=root.querySelector('[data-project-panel-title]');const text=root.querySelector('[data-project-panel-copy]');if(!(label instanceof HTMLElement)||!(panelTitle instanceof HTMLElement)||!(text instanceof HTMLElement))return;root.querySelectorAll('[data-project-node]').forEach((node)=>{if(!(node instanceof HTMLElement))return;node.addEventListener('click',()=>{const d=copy[node.dataset.step||''];if(!d)return;root.querySelectorAll('[data-project-node]').forEach(n=>n.classList.remove('active'));node.classList.add('active');label.textContent=d[0];panelTitle.textContent=d[1];text.textContent=d[2];const meter=root.querySelector('[data-project-meter]');if(meter instanceof HTMLElement){meter.style.width=((index+1)/steps.length*100)+'%';}})})})();
</script>
